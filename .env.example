# Local development (npm run dev:admin / dev:issuer / dev:verifier). Everything has a default; these are the useful knobs.
ADMIN_USER=admin
ADMIN_PASSWORD=admin
SESSION_SECRET=change-me-change-me-change-me
# Cross-service URLs (browser-visible!)
ADMIN_URL=http://localhost:3001
ISSUER_URL=http://localhost:3002
VERIFIER_URL=http://localhost:3003
# Issuer
OCR_PROVIDER=tesseract        # tesseract | mock
FACE_PROVIDER=mock            # mock | http
# FACE_API_URL=https://your-face-service/compare
# FACE_API_KEY=
# FACE_THRESHOLD=0.8
PASSIVE_AUTH=demo             # demo | strict
# CSCA_PEM="-----BEGIN CERTIFICATE-----\n…"   # one or more CSCA certs (PEM, concatenated)
# DATABASE_URL=postgres://user:pass@host:5432/db   # omit for in-memory storage
