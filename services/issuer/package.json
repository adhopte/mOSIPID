{
  "name": "@mosipid/issuer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "fetch-models": "node scripts/fetch-models.js",
    "build": "node scripts/fetch-models.js && esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --external:pg --external:express --external:qrcode --external:sharp --external:tesseract.js --external:@tesseract.js-data/eng --external:onnxruntime-node --external:@cornerstonejs/codec-openjpeg",
    "start": "node dist/index.js",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsx --test test/*.test.ts",
    "gen:iaca": "tsx src/gen-iaca.ts"
  },
  "dependencies": {
    "@cornerstonejs/codec-openjpeg": "^1.3.6",
    "@mosipid/core": "*",
    "@mosipid/server-kit": "*",
    "@tesseract.js-data/eng": "^1.0.0",
    "onnxruntime-node": "^1.30.0",
    "tesseract.js": "^5.1.1"
  },
  "optionalDependencies": {
    "sharp": "^0.33.5"
  }
}
