{
  "name": "@mosipid/verifier",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --external:pg --external:express --external:qrcode",
    "start": "node dist/index.js",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": { "@mosipid/core": "*", "@mosipid/server-kit": "*" }
}
