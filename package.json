{
  "name": "mosipid",
  "private": true,
  "version": "0.1.0",
  "description": "Inji-compatible wallet, issuer, verifiers (remote + proximity) and branding portal",
  "workspaces": ["packages/*", "services/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:admin": "npm run dev -w @mosipid/admin",
    "dev:issuer": "npm run dev -w @mosipid/issuer",
    "dev:verifier": "npm run dev -w @mosipid/verifier",
    "gen:iaca": "npm run gen:iaca -w @mosipid/issuer"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.3",
    "@types/node": "^22.0.0"
  }
}
